# Variables to set on JeanZay for INTEL compiler
set(ENV{CC} "icc")
set(ENV{CXX} "icpc")
set(ENV{FC} "ifort")

# modules to load for INTEL compiler
module purge
module load intel-compilers/2021.9.0
module load intel-mpi/2021.9
module load petsc/3.24.1-mpi
module load fftw/3.3.10-mpi
module load cmake/3.31.4
module load python/3.10.4